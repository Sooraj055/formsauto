# Fernet key, or any long stable secret. A non-Fernet value is hashed into a key.
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable across deploys or the encrypted profile cannot be decrypted.
FORMRUSH_SECRET_KEY=

# Strongly recommended when hosting publicly so only you can access your profile
FORMRUSH_ACCESS_PIN=

# Optional initial profile preload on first startup (saved encrypted in data/formrush.db)
FORMRUSH_DEFAULT_NAME=
FORMRUSH_DEFAULT_MOBILE=
FORMRUSH_DEFAULT_EMAIL=
FORMRUSH_DEFAULT_TICKETS=4
FORMRUSH_DEFAULT_CITY=
FORMRUSH_DEFAULT_ADDRESS=
FORMRUSH_DEFAULT_PIN=

# Optional storage directory (default: ./data)
FORMRUSH_DATA_DIR=./data

# Optional tuning (milliseconds)
FORMRUSH_GOTO_TIMEOUT_MS=15000
FORMRUSH_ACTION_TIMEOUT_MS=5000
FORMRUSH_SUBMIT_TIMEOUT_MS=15000
